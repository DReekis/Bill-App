{
  "name": "pricepilot-bill-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx test/server.test.ts test/admin.test.ts test/subscription.test.ts test/sandbox.test.ts",
    "db:postgres": "node scripts/prepare-db.js postgresql && prisma generate",
    "db:sqlite": "node scripts/prepare-db.js sqlite && prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^11.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "razorpay": "^2.9.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.14.12",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
