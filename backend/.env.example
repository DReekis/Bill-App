PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://billket_user:your_secure_db_password@postgres:5432/billket_db?schema=public
JWT_SECRET=generate_a_64_char_random_cryptographic_secret_here

# Executive Admin Dashboard Credentials
ADMIN_EMAIL=admin@yourdomain.in
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_2026!

# 2Factor.in SMS Gateway Credentials (https://2factor.in)
TWOFACTOR_API_KEY=your_2factor_api_key_here
TWOFACTOR_BASE_URL=https://2factor.in/API/V1

# Razorpay Payment Gateway (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Sandbox.co.in GST & E-Invoicing API (https://sandbox.co.in)
SANDBOX_API_KEY=key_live_your_sandbox_key_here
SANDBOX_API_SECRET=secret_live_your_sandbox_secret_here
SANDBOX_BASE_URL=https://api.sandbox.co.in
