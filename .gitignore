# -------------------------------------------------------------------------
# Root .gitignore for Billket / PricePilot Bill
# -------------------------------------------------------------------------

# Operating System & Editor Files
.DS_Store
Thumbs.db
*.swp
*.bak
*~
.vscode/
.idea/
*.iml
*.ipr
*.iws
PROJECT_STATE.md

# Node / Backend
node_modules/
backend/node_modules/
dist/
backend/dist/
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*.db-shm
backend/backups/*.db
backend/backups/
backend/.env
backend/.env.local
backend/.env.production
backend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Dart Build & Tooling
.dart_tool/
app/.dart_tool/
.packages
.pub-cache/
.pub/
app/.packages
app/.pub-cache/
app/.pub/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# App Build Artifacts
build/
app/build/
**/build/
app/android/build/
app/android/.gradle/
app/android/app/build/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
*.apk
*.aab
*.symbols
*.map.json

# Local Properties & Secret Keys
app/android/local.properties
app/android/key.properties
*.jks
*.keystore

# Temporary and Scratch Directories
scratch/
.system_generated/
*.log
